# LS_COLORS — Default+. Sourced by ~/.zshrc; do not hand-edit.
#
# vivid ships no Default+ theme, so this is not `vivid generate <name>`. It is
# vivid's filetype database — theme-independent, the same ~677 rules in every
# vivid theme, differing only in which colour each rule points at — with the
# palette substituted role by role. The previous Kanagawa Dragon set was built
# the same way from vivid's gruvbox-dark; this one is that set remapped again.
#
# Unlike last time, the substitution table is committed rather than left in a
# commit message. Each of the 17 colours vivid uses maps to the Default+ role
# that fills the same job:
#
#   115;124;115     -> dim / backup & temp      -> muted_text #8E8E8E
#   185;141;123     -> markup & docs            -> attribute  #E09D65
#   24;22;22        -> background               -> background #171717
#   195;64;67       -> capability bg            -> muted_red  #8A2E34
#   200;192;147     -> config & data files      -> number     #FFE76D
#   196;178;138     -> directories              -> declaration #35B0D8
#   137;146;167     -> doors / special          -> system_member #AB64FF
#   135;169;135     -> executables              -> comment    #2EA85B
#   197;201;197     -> plain text / foreground  -> plain      #FFFFFF
#   232;36;36       -> orphaned symlink         -> error      #F74A4A
#   162;146;163     -> sockets & pipes          -> keyword    #F2248C
#   182;146;123     -> archives                 -> macro      #FD8F3F
#   138;154;123     -> source code              -> project_identifier #56D0B3
#   139;164;176     -> documents                -> url        #4FA5FF
#   142;164;162     -> images & audio           -> declaration_type #66DAFF
#   148;159;181     -> video                    -> system_type #D0A8FF
#   196;116;110     -> disk images              -> string     #FC4651
#
# Regenerate by re-running that substitution; keep it a single export line so
# the diff stays one line.
#
# Directories are `declaration` #35B0D8, this setup's accent. Note the palette
# has no separate "accent" — Default+ comes from an editor theme, where the
# nearest equivalent is the colour Xcode gives a declaration.
#
# Note this is the *GNU* variable. BSD /bin/ls ignores it and reads LSCOLORS
# instead — see the note in .zshrc where that is set.

