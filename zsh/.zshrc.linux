# Linux-only (Fedora) zsh config. Sourced automatically by .zshrc.

# GNU ls color support
alias ls="ls --color=auto"

# Clipboard helpers matching the tmux copy-mode bindings
if command -v wl-copy >/dev/null 2>&1; then
  alias clipcopy="wl-copy"
  alias clippaste="wl-paste"
elif command -v xclip >/dev/null 2>&1; then
  alias clipcopy="xclip -selection clipboard"
  alias clippaste="xclip -selection clipboard -o"
fi

if [[ -d "/home/linuxbrew/.linuxbrew/bin/" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

# macOS-style `open` for Linux, backed by xdg-open.
open() {
  if ! command -v xdg-open >/dev/null 2>&1; then
    echo "[Error] 'open' requires xdg-open (xdg-utils)" >&2
    return 1
  fi

  if [ $# -eq 0 ]; then
    nohup xdg-open . >/dev/null 2>&1 &
    disown
    return 0
  fi

  local item rc=0
  for item in "$@"; do
    if [ -e "$item" ] || [[ "$item" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
      nohup xdg-open "$item" >/dev/null 2>&1 &
      disown
    else
      echo "[Error] 'open' target invalid or unreachable: $item" >&2
      rc=1
    fi
  done

  return $rc
}
