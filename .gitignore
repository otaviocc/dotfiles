.DS_Store
*.local
__pycache__/
*.pyc
.venv/

# Claude Code: the `claude` package tracks themes/, skills/ and statusline.py
# only. settings.json selects the theme and wires the statusline but also
# carries API tokens, and the rest of ~/.claude is session/runtime state.
# Ignored rather than merely absent, so a stray `git add claude/` can't pull a
# token into history. skills/ is shared with opencode, which also reads
# ~/.claude/skills/.
/claude/.claude/*
!/claude/.claude/themes/
!/claude/.claude/skills/
!/claude/.claude/statusline.py

# Claude Code syncs its built-in (Anthropic-provided) skills into
# skills/synced/ at runtime; it's generated, not hand-written, so it's
# excluded even though skills/ itself is tracked.
/claude/.claude/skills/synced/

# hunk writes runtime state next to its tracked config; only config.toml
# belongs in the repo (same split as herdr and holodeck).
/hunk/.config/hunk/state.json

# Exceptions: these *.local files are pre-committed relative symlinks that
# make up the OS-overlay packages (see README "Handling Fedora vs macOS
# differences"), not machine-local runtime state.
!/git-macos/.gitconfig.local
!/git-linux/.gitconfig.local
!/ghostty-macos/.config/ghostty/config.local
!/ghostty-linux/.config/ghostty/config.local
