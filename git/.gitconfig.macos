[commit]
	gpgsign = false

[gpg]
	program = /opt/homebrew/bin/gpg

[diff]
	tool = Kaleidoscope

[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

[difftool]
	prompt = false

# Work-only overrides (issue-tracker templates, SSH-signing key path, etc).
# Untracked, created by hand on machines that need it — silently skipped
# by git if the file doesn't exist (e.g. the personal Mac).
[include]
	path = ~/.gitconfig.local.work
