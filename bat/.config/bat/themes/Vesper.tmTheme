<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Vesper for bat (matches ghostty/nvim/tig/lazygit/hunk/vigia/opencode/zsh).
     Upstream palette: https://github.com/raunofreiberg/vesper
     Rebuild bat's cache after editing: bat cache --build -->
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Vesper</string>
    <key>semanticClass</key>
    <string>theme.dark.vesper</string>
    <key>uuid</key>
    <string>0c3d4f2a-6f1b-4a1e-9c9a-1f6d2b7f8e10</string>
    <key>colorSpaceName</key>
    <string>sRGB</string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>
                <string>#101010</string>
                <key>foreground</key>
                <string>#FFFFFF</string>
                <key>caret</key>
                <string>#FFFFFF</string>
                <key>lineHighlight</key>
                <string>#1C1C1C</string>
                <key>selection</key>
                <string>#232323</string>
                <key>selectionBorder</key>
                <string>#232323</string>
                <key>invisibles</key>
                <string>#505050</string>
                <key>gutter</key>
                <string>#101010</string>
                <key>gutterForeground</key>
                <string>#505050</string>
                <key>findHighlight</key>
                <string>#FFC799</string>
                <key>findHighlightForeground</key>
                <string>#101010</string>
            </dict>
        </dict>

        <dict>
            <key>name</key>
            <string>Comment</string>
            <key>scope</key>
            <string>comment, punctuation.definition.comment</string>
            <key>settings</key>
            <dict>
                <key>fontStyle</key>
                <string>italic</string>
                <key>foreground</key>
                <string>#7E7E7E</string>
            </dict>
        </dict>

        <dict>
            <key>name</key>
            <string>String</string>
            <key>scope</key>
            <string>string, string.quoted, meta.string, punctuation.definition.string</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#90B99F</string>
            </dict>
        </dict>

        <dict>
            <key>name</key>
            <string>String interpolation and escapes</string>
            <key>scope</key>
            <string>constant.character.escape, punctuation.definition.template-expression, punctuation.section.embedded, meta.embedded, string.regexp</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>#ECAAD6</string>
            </dict>
        </dict>

        <dict>
