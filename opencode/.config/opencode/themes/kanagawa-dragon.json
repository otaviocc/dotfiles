{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "dragonBlack1": "#12120f",
    "dragonBlack3": "#181616",
    "dragonBlack4": "#282727",
    "dragonBlack5": "#393836",
    "dragonBlack6": "#625e5a",
    "dragonWhite": "#c5c9c5",
    "dragonGray2": "#9e9b93",
    "dragonAsh": "#737c73",
    "dragonRed": "#c4746e",
    "dragonGreen": "#87a987",
    "dragonGreen2": "#8a9a7b",
    "dragonYellow": "#c4b28a",
    "dragonOrange": "#b6927b",
    "dragonBlue2": "#8ba4b0",
    "dragonPink": "#a292a3",
    "dragonAqua": "#8ea4a2",
    "dragonViolet": "#8992a7",
    "samuraiRed": "#e82424",
    "roninYellow": "#ff9e3b",
    "springGreen": "#98bb6c",
    "waveAqua1": "#6a9589",
    "autumnGreen": "#76946a",
    "autumnRed": "#c34043",
    "winterGreen": "#2b3328",
    "winterRed": "#43242b",
    "diffAddedGutter": "#2d3228",
    "diffRemovedGutter": "#3e1f20"
  },
  "theme": {
    "primary": { "dark": "dragonYellow", "light": "dragonYellow" },
    "secondary": { "dark": "dragonViolet", "light": "dragonViolet" },
    "accent": { "dark": "dragonBlue2", "light": "dragonBlue2" },
    "error": { "dark": "samuraiRed", "light": "samuraiRed" },
    "warning": { "dark": "roninYellow", "light": "roninYellow" },
    "success": { "dark": "springGreen", "light": "springGreen" },
    "info": { "dark": "waveAqua1", "light": "waveAqua1" },

    "text": { "dark": "dragonWhite", "light": "dragonWhite" },
    "textMuted": { "dark": "dragonAsh", "light": "dragonAsh" },

    "background": { "dark": "dragonBlack3", "light": "dragonBlack3" },
    "backgroundPanel": { "dark": "dragonBlack1", "light": "dragonBlack1" },
    "backgroundElement": { "dark": "dragonBlack4", "light": "dragonBlack4" },

    "border": { "dark": "dragonBlack6", "light": "dragonBlack6" },
    "borderActive": { "dark": "dragonYellow", "light": "dragonYellow" },
    "borderSubtle": { "dark": "dragonBlack5", "light": "dragonBlack5" },

    "diffAdded": { "dark": "autumnGreen", "light": "autumnGreen" },
    "diffRemoved": { "dark": "autumnRed", "light": "autumnRed" },
    "diffContext": { "dark": "dragonAsh", "light": "dragonAsh" },
    "diffHunkHeader": { "dark": "dragonViolet", "light": "dragonViolet" },
    "diffHighlightAdded": { "dark": "dragonGreen", "light": "dragonGreen" },
    "diffHighlightRemoved": { "dark": "dragonRed", "light": "dragonRed" },
    "diffAddedBg": { "dark": "winterGreen", "light": "winterGreen" },
    "diffRemovedBg": { "dark": "winterRed", "light": "winterRed" },
    "diffContextBg": { "dark": "dragonBlack3", "light": "dragonBlack3" },
    "diffLineNumber": { "dark": "dragonBlack6", "light": "dragonBlack6" },
    "diffAddedLineNumberBg": { "dark": "diffAddedGutter", "light": "diffAddedGutter" },
    "diffRemovedLineNumberBg": { "dark": "diffRemovedGutter", "light": "diffRemovedGutter" },

    "markdownText": { "dark": "dragonWhite", "light": "dragonWhite" },
    "markdownHeading": { "dark": "dragonYellow", "light": "dragonYellow" },
    "markdownLink": { "dark": "dragonBlue2", "light": "dragonBlue2" },
    "markdownLinkText": { "dark": "dragonAqua", "light": "dragonAqua" },
    "markdownCode": { "dark": "dragonGreen2", "light": "dragonGreen2" },
    "markdownBlockQuote": { "dark": "dragonAsh", "light": "dragonAsh" },
    "markdownEmph": { "dark": "dragonOrange", "light": "dragonOrange" },
    "markdownStrong": { "dark": "dragonYellow", "light": "dragonYellow" },
    "markdownHorizontalRule": { "dark": "dragonAsh", "light": "dragonAsh" },
    "markdownListItem": { "dark": "dragonBlue2", "light": "dragonBlue2" },
    "markdownListEnumeration": { "dark": "dragonAqua", "light": "dragonAqua" },
    "markdownImage": { "dark": "dragonBlue2", "light": "dragonBlue2" },
    "markdownImageText": { "dark": "dragonAqua", "light": "dragonAqua" },
    "markdownCodeBlock": { "dark": "dragonWhite", "light": "dragonWhite" },

    "syntaxComment": { "dark": "dragonAsh", "light": "dragonAsh" },
    "syntaxKeyword": { "dark": "dragonViolet", "light": "dragonViolet" },
    "syntaxFunction": { "dark": "dragonBlue2", "light": "dragonBlue2" },
    "syntaxVariable": { "dark": "dragonWhite", "light": "dragonWhite" },
    "syntaxString": { "dark": "dragonGreen2", "light": "dragonGreen2" },
    "syntaxNumber": { "dark": "dragonPink", "light": "dragonPink" },
    "syntaxType": { "dark": "dragonAqua", "light": "dragonAqua" },
    "syntaxOperator": { "dark": "dragonRed", "light": "dragonRed" },
    "syntaxPunctuation": { "dark": "dragonGray2", "light": "dragonGray2" }
  }
}
