# Ghostty config — shared across Fedora and macOS.
#
# NOTE: this version of Ghostty expects the file at
# $XDG_CONFIG_HOME/ghostty/config.ghostty (verify with `ghostty +show-config
# --default --docs | grep xdg_config_home` if a future Ghostty release on
# either machine expects plain `config` instead — rename/symlink as needed).

# Theme (vendored in themes/Default+, see README "The Default+ theme")
theme = "Default+"
bold-color = bright
split-divider-color = #2EA85B

# Font (unset: use each OS's default monospace font)
font-size = 13

# Cursor
cursor-style = block
cursor-style-blink = true

# Window size
maximize = false
window-width = 140
window-height = 40

# Shell
shell-integration = zsh
keybind = shift+enter=text:\n

# background
#background-opacity = 0.7
#background-blur-radius = 10
unfocused-split-opacity = 0.75

copy-on-select = true
mouse-hide-while-typing = true

# OS-specific overrides (macos-option-as-alt, macos-icon, ...). Tracked as
# config.linux / config.macos in this repo; the ghostty-linux/ghostty-macos
# overlay package stows a pre-committed symlink so the right one ends up at
# config.local for the machine it runs on. The "?" prefix makes this
# optional so Ghostty won't error before install.sh has run.
config-file = ?config.local
