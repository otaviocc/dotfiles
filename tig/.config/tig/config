# Kanagawa Dragon theme (accent: yellow)
# Palette: see docs/palette.md. Upstream: https://github.com/rebelot/kanagawa.nvim
#
# tig 2.6.1 has no hex/true-color support, so every colour below is a 256-colour
# stand-in. Unlike the previous themes these were NOT chosen by nearest-RGB:
# Dragon is deliberately low-chroma, and a plain nearest-neighbour search sends
# half the palette onto the xterm *greyscale* ramp — `green` #8a9a7b lands on
# color245, `aqua` and `pink` both on color247 — which would render tig almost
# entirely monochrome and collapse three syntax roles into one. Restricting the
# search to the 6x6x6 colour cube instead just moves the collisions around.
#
# So these are hand-picked for maximum distinctness while keeping each hue
# recognisable. They are approximations of approximations; the truecolor tools
# are the reference, not this file.
#
# Only the roles tig actually has are listed — it exposes no string/type/
# function scopes, so most of the syntax palette never reaches it.
#
#   fg           #c5c9c5 -> color188   text
#   comment      #737c73 -> color243   (unused; kept for reference)
#   special      #7a8382 -> color245   muted chrome, line numbers
#   yellow       #c4b28a -> color180   THE ACCENT — cursor, titles, dirs, HEAD
#   violet       #8992a7 -> color103   authors, refs, chunk headers
#   pink         #a292a3 -> color139   remotes, tracked, prefetch
#   orange       #b6927b -> color137   unstaged changes
#   vcs_added    #76946a -> color65    added / staged / notes
#   vcs_removed  #c34043 -> color131   removed / untracked / replaced
#   vcs_changed  #dca561 -> color179   changed / tags / stash / commit ids
#   bg_m3        #0d0c0c -> color232   text on a filled accent
#   bg_p1        #282727 -> color235   the one non-default background (blurred
#                                      title and cursor rows)
#
# Backgrounds are left as `default` so tig inherits the terminal's real
# #181616 from Ghostty rather than an approximation — the same reasoning as
# above, applied to the background.

# Layout
set vertical-split = false

# Base UI
color default        color188 default
color cursor          color232 color180
color cursor-blur     color188 color235
color status          color188 default
color title-focus     color232 color180
color title-blur      color188 color235
color search-result   color232 color180
color header          color188 default
color line-number     color245 default
color delimiter       color245 default
color id              color179 default
color date            color188 default
color author          color103 default
color committer       color188 default
color mode            color245 default
color overflow        color245 default
color directory       color180 default
color file            color188 default
color file-size       color245 default

# Diff view
color diff-add        color65  default
color diff-del         color131 default
color diff-header      color180 default
color diff-chunk        color103 default

# Log / commit graph
color graph-commit    color180 default
color main-commit     color188 default
color main-annotated  color103 default
color main-head       color180 default bold
color main-remote     color139 default
color main-tracked    color139 default
color main-tag        color179 default
color main-local-tag  color179 default
color main-ref        color103 default
color main-replace    color131 default
color main-stash      color179 default
color main-note       color65  default
color main-prefetch   color139 default
color main-other      color188 default

# Status view
color stat-none      color245 default
color stat-staged     color65  default
color stat-unstaged    color137 default
color stat-untracked     color131 default

# Help view
color help-group   color180 default bold
color help-action   color188 default

# Tree view
color tree.directory   color180 default
color tree.file        color188 default
