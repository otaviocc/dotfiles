# Catppuccin Mocha theme (accent: mauve)
# Palette: see docs/palette.md. Upstream: https://github.com/catppuccin/catppuccin
#
# tig 2.6.1 has no hex/true-color support, so every colour below is the nearest
# xterm-256 index:
#   text     #cdd6f4 -> color189 (#d7d7ff)
#   subtext0 #a6adc8 -> color146 (#afafd7)
#   overlay1 #7f849c -> color103 (#8787af)
#   surface2 #585b70 -> color241 (#626262)
#   surface1 #45475a -> color239 (#4e4e4e)
#   surface0 #313244 -> color237 (#3a3a3a)
#   mauve    #cba6f7 -> color183 (#d7afff)
#   lavender #b4befe -> color147 (#afafff)
#   pink     #f5c2e7 -> color218 (#ffafd7)
#   red      #f38ba8 -> color211 (#ff87af)
#   peach    #fab387 -> color216 (#ffaf87)
#   yellow   #f9e2af -> color223 (#ffd7af)
#   green    #a6e3a1 -> color151 (#afd7af)
#
# Backgrounds are deliberately left as `default` rather than approximated.
# Mocha's darks are all blue-tinted (base #1e1e2e, mantle #181825, crust
# #11111b) and the 256-colour palette has no tinted near-blacks — the nearest
# entries are the *grey* ramp (color235/234/233), which would leave tig sitting
# on a visibly colder, flatter background than every other tool. Inheriting
# `default` instead means tig gets the terminal's real #1e1e2e from Ghostty's
# built-in Catppuccin Mocha, exactly matching its neighbours. Only genuinely
# *highlighted* backgrounds get an explicit index.

# Layout
set vertical-split = false

# Base UI
color default        color189 default
color cursor          color237 color183
color cursor-blur     color189 color237
color status          color189 default
color title-focus     color237 color183
color title-blur      color189 color237
color search-result   color237 color183
color header          color189 default
color line-number     color241 default
color delimiter       color241 default
color id              color223 default
color date            color189 default
color author          color147 default
color committer       color189 default
color mode            color241 default
color overflow        color241 default
color directory       color218 default
color file            color189 default
color file-size       color241 default

# Diff view
color diff-add        color151 default
color diff-del         color211 default
color diff-header      color183 default
color diff-chunk        color147 default

# Log / commit graph
color graph-commit    color183 default
color main-commit     color189 default
color main-annotated  color147 default
color main-head       color183 default bold
color main-remote     color218 default
color main-tracked    color218 default
color main-tag        color223 default
color main-local-tag  color223 default
color main-ref        color147 default
color main-replace    color211 default
color main-stash      color223 default
color main-note       color151 default
color main-prefetch   color218 default
color main-other      color189 default

# Status view
color stat-none      color241 default
color stat-staged     color151 default
color stat-unstaged    color216 default
color stat-untracked     color211 default

# Help view
color help-group   color183 default bold
color help-action   color189 default

# Tree view
color tree.directory   color218 default
color tree.file        color189 default
