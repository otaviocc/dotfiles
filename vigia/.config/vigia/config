# vigia view preferences — checked against vigia 0.30.0.
# Same syntax as the theme file. Defaults: everything off, except `links`.
# All of these are still togglable in-session with m / r / s / a.

masthead = off    # the churn band at the top
rail     = off    # the file list beside the diff, from 134 columns
single   = off    # one file at a time
staged   = on     # what is staged, beside what is not
icons    = on     # a file-type glyph before every listed path (needs a Nerd Font)
links    = on     # OSC 8 file:// links on listed paths (on by default)
