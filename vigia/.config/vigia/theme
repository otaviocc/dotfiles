# Vesper theme for vigia
#
# Place at ~/.config/vigia/theme, or point to it with:
#   VIGIA_THEME=~/path/to/this/file
#
# Starts from the `dark` built-in and overrides every key.
# Checked against vigia 0.30.0 — re-diff crates/vigia/src/theme.rs when
# bumping, since an unset key silently inherits `dark` rather than erroring.
# Palette: https://github.com/raunofreiberg/vesper (the ANSI set Ghostty
# and herdr both draw with — see README "The Vesper theme").

base       = dark

chrome     = #f591b2 bold
chrome_dim = #7e7e7e

# Chrome pills (truecolour only; background-only so chrome/chrome_dim keep
# their fg): the segmented chrome behind the branch/count and worktree name.
chip        = on #1c1c1c
chip_accent = on #232323

path       = #ffffff bold
path_live  = #ffffff
path_cold  = #7e7e7e
path_hover = #f0c9d6 underline

pulse       = #ea83a5
spark       = #ea83a5
spark_warm  = #f5c1d2
spark_hot   = #fbe6ed
# A sparkline draws a thin `_` stroke, not a block, so its track needs more
# contrast than a heat strip's to read at all — this used to duplicate
# heat_track (~2.05:1 against our #101010 bg) and all but vanished. #7e7e7e
# is the same "muted_text" tone `gutter`/`chrome_dim`/`comment` already use.
spark_track = #7e7e7e

bar        = #a0a0a0
bar_active = #ffffff
bar_hover  = #d0d0d0
bar_track  = #474747

# One step darker than spark_track for the same reason, but still a step up
# from the old #474747 (~2.05:1) so the strip's track reads as a track.
heat_track       = #505050
heat_added       = #90b99f
heat_added_warm  = #95dcc2
heat_added_hot   = #99ffe4
heat_removed     = #f5a191
heat_removed_warm = #fa9189
heat_removed_hot = #ff8080
heat_mixed       = #e6b99d
heat_mixed_warm  = #f3c09b
heat_mixed_hot   = #ffc799

kind    = #e6b99d
hunk    = #b9aeda
gutter  = #7e7e7e
added   = #90b99f
removed = #f5a191
context = #ffffff

# The palette's own green, the same one `added` takes.
staged = #90b99f

added_row   = on #232925
removed_row = on #322623
added_bar   = on #90b99f
removed_bar = on #f5a191

# Word emphasis: the row wash stepped toward the diff hue, never a new role.
added_word   = on #2f4437
removed_word = on #4c332d

# Two-tone gutter: one step darker than the wash it sits beside.
added_gutter   = on #1a1e1b
removed_gutter = on #241d1b

note  = #e29eca
alert = #ff8080 bold

keyword   = #ff8080
type_name = #ffc799
function  = #ecaad6
variable  = #b9aeda
constant  = #e6b99d
string    = #99ffe4
number    = #f591b2
comment   = #7e7e7e
