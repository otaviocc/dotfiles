# Catppuccin Mocha, the palette Ghostty and Neovim both draw with.
# Full table, including the derived shades below: docs/palette.md
# vigia has no upstream Catppuccin port, so these are transcribed by hand.
base       = dark

chrome      = #cba6f7 bold
chrome_dim  = #7f849c
path        = #cdd6f4 bold
path_live   = #cdd6f4
path_cold   = #7f849c
path_hover  = #f9e2af underline

pulse       = #cba6f7
spark       = #b4befe
spark_warm  = #cba6f7
spark_hot   = #f5c2e7
spark_track = #45475a

bar        = #9399b2
bar_active = #cdd6f4
bar_hover  = #a6adc8
bar_track  = #45475a

heat_track       = #45475a
heat_added       = #94e2d5
heat_added_warm  = #a6e3a1
heat_added_hot   = #f9e2af
heat_removed     = #f2cdcd
heat_removed_warm = #eba0ac
heat_removed_hot = #f38ba8
heat_mixed       = #74c7ec
heat_mixed_warm  = #fab387
heat_mixed_hot   = #f38ba8

kind    = #f9e2af
staged  = #a6e3a1
hunk    = #b4befe
gutter  = #7f849c
added   = #a6e3a1
removed = #f38ba8
context = #cdd6f4

added_row      = on #394545
removed_row    = on #493447
added_word     = on #4e6356
removed_word   = on #694559
added_gutter   = on #3c4947
removed_gutter = on #4d3649
added_bar      = on #a6e3a1
removed_bar    = on #f38ba8

note  = #cba6f7
alert = #f38ba8 bold

# Syntax follows Catppuccin's own style guide (see docs/palette.md).
keyword   = #cba6f7
type_name = #f9e2af
function  = #89b4fa
variable  = #cdd6f4
constant  = #fab387
string    = #a6e3a1
number    = #fab387
comment   = #9399b2
