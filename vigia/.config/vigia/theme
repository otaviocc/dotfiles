# Kanagawa Dragon, the palette Ghostty and Neovim both draw with.
# Full table, including the derived shades below: docs/palette.md
base       = dark

chrome      = #c4b28a bold
chrome_dim  = #737c73
path        = #c5c9c5 bold
path_live   = #c5c9c5
path_cold   = #737c73
path_hover  = #dca561 underline

pulse       = #c4b28a
spark       = #c4b28a
spark_warm  = #dca561
spark_hot   = #c8c093
spark_track = #393836

bar        = #7a8382
bar_active = #c5c9c5
bar_hover  = #9e9b93
bar_track  = #393836

heat_track       = #393836
heat_added       = #8a9a7b
heat_added_warm  = #87a987
heat_added_hot   = #98bb6c
heat_removed     = #c4746e
heat_removed_warm = #c34043
heat_removed_hot = #e82424
heat_mixed       = #b6927b
heat_mixed_warm  = #dca561
heat_mixed_hot   = #ff9e3b

kind    = #dca561
staged  = #76946a
hunk    = #8992a7
gutter  = #737c73
added   = #76946a
removed = #c34043
context = #c5c9c5

added_row      = on #2b3328
removed_row    = on #43242b
added_word     = on #394233
removed_word   = on #542526
added_gutter   = on #2d3228
removed_gutter = on #3e1f20
added_bar      = on #76946a
removed_bar    = on #c34043

note  = #c4b28a
alert = #e82424 bold

# Syntax follows Dragon's own `syn` table (see docs/palette.md).
keyword   = #8992a7
type_name = #8ea4a2
function  = #8ba4b0
variable  = #c5c9c5
constant  = #b6927b
string    = #8a9a7b
number    = #a292a3
comment   = #737c73
