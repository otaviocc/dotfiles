# Vesper theme for vigia
#
# Place at ~/.config/vigia/theme, or point to it with:
#   VIGIA_THEME=~/path/to/this/file
#
# Starts from the `dark` built-in and overrides every key.
# Palette: https://github.com/raunofreiberg/vesper (the ANSI set Ghostty
# and herdr both draw with — see README "The Vesper theme").

base       = dark

chrome     = #f591b2 bold
chrome_dim = #7e7e7e
path       = #ffffff bold
path_live  = #ffffff
path_cold  = #7e7e7e
path_hover = #f0c9d6 underline

pulse       = #ea83a5
spark       = #ea83a5
spark_warm  = #f5c1d2
spark_hot   = #fbe6ed
spark_track = #474747

bar        = #a0a0a0
bar_active = #ffffff
bar_hover  = #d0d0d0
bar_track  = #474747

heat_track       = #474747
heat_added       = #90b99f
heat_added_warm  = #95dcc2
heat_added_hot   = #99ffe4
heat_removed     = #f5a191
heat_removed_warm = #fa9189
heat_removed_hot = #ff8080
heat_mixed       = #e6b99d
heat_mixed_warm  = #f3c09b
heat_mixed_hot   = #ffc799

kind    = #e6b99d
hunk    = #b9aeda
gutter  = #7e7e7e
added   = #90b99f
removed = #f5a191
context = #ffffff

added_row   = on #232925
removed_row = on #322623
added_bar   = on #90b99f
removed_bar = on #f5a191

note  = #e29eca
alert = #ff8080 bold

keyword   = #ff8080
type_name = #ffc799
function  = #ecaad6
variable  = #b9aeda
constant  = #e6b99d
string    = #99ffe4
number    = #f591b2
comment   = #7e7e7e
